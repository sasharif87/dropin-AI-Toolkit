# dropin-AI-Toolkit host configuration
#
# Copy to .env (same directory — the toolkit root). .env is gitignored, so
# LAN IPs and machine names stay out of commits. Real environment variables
# always win over .env; a .dropin.json or an explicit CLI flag beats both.
# The .env is read only from the toolkit's own directory, never from the
# repo you point the tools at.

# Ollama host for the generation half (drop.py develop/test/review/fix)
# and the fallback default for codex.py.
#OLLAMA_HOST=http://localhost:11434

# codex.py primary host — e.g. a beefier box on your LAN. Tried first,
# falls back to CODEX_LOCAL_HOST when unreachable.
#CODEX_HOST=http://192.168.x.x:11434

# codex.py fallback host (usually the machine you're typing on).
#CODEX_LOCAL_HOST=http://localhost:11434

# codex.py default model and request timeout in seconds.
#CODEX_MODEL=qwen3-coder:30b
#CODEX_TIMEOUT=600
